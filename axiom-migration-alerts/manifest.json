{
  "manifest_version": 3,
  "name": "Axiom Migration Alerts",
  "version": "1.0.0",
  "description": "Alerts you when a ticker on Axiom Pulse has previously migrated past the pump.fun bonding curve within the last year.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Axiom Migration Alerts"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://axiom.trade/*",
    "https://frontend-api.pump.fun/*",
    "https://frontend-api-v3.pump.fun/*",
    "https://api.dexscreener.com/*"
  ]
}
